# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (used in notification links)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ——— New inquiry notifications ———
# Where to send alerts (Gmail, Outlook, etc.). Falls back to Admin → Settings → Contact email.
NOTIFY_EMAIL=you@gmail.com

# Optional instant ping (Discord / Slack / Make.com). Remove this line if you only want email.
# NOTIFY_WEBHOOK_URL=https://discord.com/api/webhooks/ID/TOKEN
# NOTIFY_WEBHOOK_TYPE=discord

# Option A — Resend (recommended): https://resend.com — free tier, any inbox
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=Flux <onboarding@resend.dev>

# Option B — SMTP (Gmail, Outlook, Zoho, …)
# Gmail: use an App Password (Google Account → Security → 2-Step Verification → App passwords)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# EMAIL_FROM=Flux <you@gmail.com>

# Option C — Webhook (Discord, Slack, Make, Zapier, …)
# Discord: Server → channel → Integrations → Webhooks → New → copy URL
# NOTIFY_WEBHOOK_URL=https://discord.com/api/webhooks/123456789/abcdef...
# Slack: apps.slack.com → Incoming Webhooks → copy URL
# NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX
# Make/Zapier: use a Custom webhook module; NOTIFY_WEBHOOK_TYPE=generic (default)
